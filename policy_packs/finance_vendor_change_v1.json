{
  "name": "finance_vendor_change_v1",
  "version": "0.1.0",
  "signed_by": "cyraduct-reference (unsigned placeholder - replace with a real domain-authority signature before production use)",
  "description": "Vendor-master changes and outbound payments. Every required fact is checked fail-closed: if the trusted adapter did not supply it, the action is denied. Facts (callback_verified, new_beneficiary, ...) must be computed by trusted code, never by an LLM or the requester.",
  "rules": [
    { "id": "fin.vendor.deny.callback_not_supplied",
      "when": { "consequence_class": "vendor_master_change", "callback_verified_missing": true },
      "effect": "deny", "reason": "Callback verification result was not supplied" },
    { "id": "fin.vendor.deny.callback_not_verified",
      "when": { "consequence_class": "vendor_master_change", "callback_verified": false },
      "effect": "deny", "reason": "Vendor change not verified by callback" },
    { "id": "fin.vendor.deny.callback_channel_unknown",
      "when": { "consequence_class": "vendor_master_change", "callback_channel_preexisting_missing": true },
      "effect": "deny", "reason": "Callback channel provenance was not supplied" },
    { "id": "fin.vendor.deny.callback_channel_from_request",
      "when": { "consequence_class": "vendor_master_change", "callback_channel_preexisting": false },
      "effect": "deny", "reason": "Callback used contact details supplied by the requester, not a pre-existing trusted channel" },
    { "id": "fin.vendor.deny.no_reviewer",
      "when": { "consequence_class": "vendor_master_change", "reviewer_id_missing": true },
      "effect": "deny", "reason": "No named human reviewer" },
    { "id": "fin.vendor.deny.beneficiary_facts_missing",
      "when": { "consequence_class": "vendor_master_change", "new_beneficiary_missing": true },
      "effect": "deny", "reason": "New-beneficiary determination was not supplied" },
    { "id": "fin.vendor.deny.new_beneficiary_no_dual_approval",
      "when": { "consequence_class": "vendor_master_change", "new_beneficiary": true, "dual_approval": false },
      "effect": "deny", "reason": "New beneficiary account requires dual approval" },
    { "id": "fin.vendor.deny.dual_approval_not_supplied",
      "when": { "consequence_class": "vendor_master_change", "new_beneficiary": true, "dual_approval_missing": true },
      "effect": "deny", "reason": "Dual-approval status was not supplied for a new beneficiary account" },
    { "id": "fin.vendor.deny.sender_domain_not_supplied",
      "when": { "consequence_class": "vendor_master_change", "sender_domain_match_missing": true },
      "effect": "deny", "reason": "Sender-domain check was not supplied" },
    { "id": "fin.vendor.conditional.sender_domain_mismatch",
      "when": { "consequence_class": "vendor_master_change", "sender_domain_match": false },
      "effect": "conditional", "reason": "Request came from a domain that does not match the vendor master; escalate before acting" },

    { "id": "fin.pay.deny.no_purpose",
      "when": { "consequence_class": "financial_transfer", "purpose_missing": true },
      "effect": "deny", "reason": "Payment without a stated purpose" },
    { "id": "fin.pay.deny.wire_ceiling",
      "when": { "action_type": "initiate_wire_transfer", "amount_gt": 5000000 },
      "effect": "deny", "reason": "Exceeds ceiling for agent-initiated wires" },
    { "id": "fin.pay.deny.bank_change_age_not_supplied",
      "when": { "consequence_class": "financial_transfer", "days_since_bank_change_missing": true },
      "effect": "deny", "reason": "Days since last vendor bank-detail change was not supplied" },
    { "id": "fin.pay.conditional.recent_bank_change",
      "when": { "consequence_class": "financial_transfer", "days_since_bank_change_lt": 3 },
      "effect": "conditional", "reason": "Vendor bank details changed within 3 days; hold for review" },
    { "id": "fin.pay.deny.large_no_dual_approval",
      "when": { "action_type": "initiate_wire_transfer", "amount_gt": 100000, "dual_approval": false },
      "effect": "deny", "reason": "Wires above 100,000 require dual approval" },
    { "id": "fin.pay.deny.large_dual_approval_not_supplied",
      "when": { "action_type": "initiate_wire_transfer", "amount_gt": 100000, "dual_approval_missing": true },
      "effect": "deny", "reason": "Dual-approval status not supplied for a wire above 100,000" },
    { "id": "fin.pay.conditional.large_ach",
      "when": { "action_type": "initiate_ach_payment", "amount_gt": 250000 },
      "effect": "conditional", "reason": "ACH above 250,000 requires review" }
  ]
}
