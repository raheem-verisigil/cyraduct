{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NCS Evidence Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "artifact",
    "source",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "ncs-evidence-manifest/0.1"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "artifact_digest"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "workflow_run": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "path",
          "sha256",
          "classification"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "classification": {
            "enum": [
              "REQUIRED",
              "SUPPORTING",
              "CHALLENGE",
              "EXCEPTION"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
