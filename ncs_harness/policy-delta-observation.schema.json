{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ncs.example/schemas/policy-delta-observation-0.1.json",
  "title": "NCS Policy Delta Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "probe_pack_id",
    "probe_id",
    "dimension",
    "run_index",
    "baseline_observation_sha256",
    "model_identity",
    "prompt_sha256",
    "generation_context",
    "policy_context",
    "policy",
    "evaluator",
    "assertions",
    "grade_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "probe_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "probe_id": {
      "type": "string",
      "pattern": "^NBB-[0-9]{3}$"
    },
    "dimension": {
      "type": "string"
    },
    "run_index": {
      "type": "integer",
      "minimum": 1
    },
    "baseline_observation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_identity": {
      "type": "object",
      "required": [
        "provider",
        "model_name",
        "model_version",
        "artifact_digest"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation_context": {
      "type": "object",
      "required": [
        "temperature",
        "tools_enabled"
      ],
      "properties": {
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "tools_enabled": {
          "const": false
        }
      }
    },
    "policy_context": {
      "const": "policy-configured"
    },
    "policy": {
      "type": "object",
      "required": [
        "pack_id",
        "version",
        "digest",
        "policy_prompt_sha256"
      ],
      "properties": {
        "pack_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "required": [
        "method",
        "evaluator_id",
        "rubric_version"
      ],
      "properties": {
        "method": {
          "enum": [
            "human-reviewed",
            "deterministic-check",
            "independent-model-assisted"
          ]
        },
        "evaluator_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rubric_version": {
          "type": "string"
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertion_id",
          "result"
        ],
        "properties": {
          "assertion_id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not-assessed"
            ]
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "grade_eligible": {
      "const": false
    }
  }
}
