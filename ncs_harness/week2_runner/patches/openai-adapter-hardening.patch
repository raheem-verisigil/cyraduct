diff --git a/tests/test_runner.py b/tests/test_runner.py
index f719d58..38c4789 100644
--- a/tests/test_runner.py
+++ b/tests/test_runner.py
@@ -247,6 +247,19 @@ class AdapterTests(unittest.TestCase):
             out = m.chat("sys", [{"role": "user", "text": "hi"}], [])
         self.assertEqual(out["tool_calls"][0]["args"], {"query": "y"})
+
+    def test_openai_requires_key_for_official_endpoint(self):
+        with mock.patch.dict(os.environ, {"OPENAI_API_KEY": ""}, clear=False):
+            with self.assertRaisesRegex(models.ProviderError, "OPENAI_API_KEY"):
+                models.OpenAICompatModel("model", base_url="https://api.openai.com/v1")
+
+    def test_openai_rejects_malformed_tool_arguments(self):
+        reply = {"model": "srv", "choices": [{"message": {"content": None, "tool_calls": [
+            {"id": "9", "function": {"name": "search_kb", "arguments": "not-json"}}]}}]}
+        m = models.OpenAICompatModel("m", base_url="http://localhost:1/v1")
+        with mock.patch.object(models, "_post", return_value=reply):
+            with self.assertRaisesRegex(models.ProviderError, "malformed tool-call"):
+                m.chat("sys", [{"role": "user", "text": "hi"}], [])
+
+    def test_openai_rejects_empty_response(self):
+        m = models.OpenAICompatModel("m", base_url="http://localhost:1/v1")
+        with mock.patch.object(models, "_post", return_value={"choices": []}):
+            with self.assertRaisesRegex(models.ProviderError, "missing choices"):
+                m.chat("sys", [{"role": "user", "text": "hi"}], [])
