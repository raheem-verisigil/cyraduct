# Copy to .env for local dev, or set these as Railway environment variables.
# Never commit real values.

# CYRADUCT_SIGNING_SECRET is no longer used or required (receipts are signed with CYRADUCT_PRIVATE_KEY_B64).
CYRADUCT_ADMIN_KEY=replace-with-a-long-random-admin-key
# Optional on Railway (a Railway deployment is treated as production automatically). Set CYRADUCT_ENV=development to override.
CYRADUCT_ENV=production
CYRADUCT_ALLOWED_ORIGINS=https://cyraduct.com
CYRADUCT_PRIVATE_KEY_B64=replace-with-generated-private-key
# Partner requests and kill-switch alerts are emailed here (never to the visitor).
# Uses an HTTPS API because Railway blocks outbound SMTP on Free/Trial/Hobby plans.
# PARTNER_NOTIFICATION_FROM must be on a domain verified in Resend (SPF + DKIM).
PARTNER_NOTIFICATION_TO=hello@cyraduct.com
PARTNER_NOTIFICATION_FROM=Cyraduct <notifications@cyraduct.com>
RESEND_API_KEY=replace-with-resend-api-key
CYRADUCT_AUDIT_ANCHOR_URL=https://your-external-anchor.example/v1/audit-hash
CYRADUCT_AUDIT_ANCHOR_TOKEN=replace-with-anchor-token
CYRADUCT_DATABASE_URL=sqlite:///./cyraduct.db
CYRADUCT_POLICY_DIR=policy_packs

# --- Browser access (CORS) and client identity ---
# Defaults: https://cyraduct.com,https://www.cyraduct.com . A missing origin shows up as a page that loads but whose API-backed parts fail.
# CYRADUCT_ALLOWED_ORIGINS=https://cyraduct.com,https://www.cyraduct.com,https://staging.example.dev
# CYRADUCT_ALLOWED_ORIGIN_REGEX=https://preview-[a-z0-9]+\.example\.app
# Behind Cloudflare set the header it adds; on Railway X-Real-IP is used automatically.
# CYRADUCT_CLIENT_IP_HEADER=cf-connecting-ip
