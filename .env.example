# Copy to .env for local dev, or set these as Railway environment variables.
# Never commit real values.

CYRADUCT_SIGNING_SECRET=replace-with-a-long-random-secret
CYRADUCT_ADMIN_KEY=replace-with-a-long-random-admin-key
CYRADUCT_ENV=production
CYRADUCT_ALLOWED_ORIGINS=https://cyraduct.com
CYRADUCT_PRIVATE_KEY_B64=replace-with-generated-private-key
PARTNER_NOTIFICATION_TO=hello@cyraduct.com
PARTNER_NOTIFICATION_FROM=Cyraduct <notifications@cyraduct.com>
RESEND_API_KEY=replace-with-resend-api-key
CYRADUCT_AUDIT_ANCHOR_URL=https://your-external-anchor.example/v1/audit-hash
CYRADUCT_AUDIT_ANCHOR_TOKEN=replace-with-anchor-token
CYRADUCT_DATABASE_URL=sqlite:///./cyraduct.db
CYRADUCT_POLICY_DIR=policy_packs
